# frozen_string_literal: true

source "https://rubygems.org"

gemspec

group :development, :test do
  gem "minitest", "~> 5.0"
  gem "rake", "~> 13.0"
end

# The alternative FOX backend (CLOGS_BACKEND=fox). FXRuby is a C++ extension
# needing FOX 1.6's development headers to build -- libfox-1.6-dev and
# libxrandr-dev on Debian and Ubuntu, fox on Homebrew -- so it is optional:
#
#   bundle config set --local with fox && bundle install
#
# See docs/backends.md.
group :fox, optional: true do
  gem "fxruby", "~> 1.6"
end

# The alternative wx backend (CLOGS_BACKEND=wx). wxRuby3 is a SWIG-generated
# C++ extension needing wxWidgets 3.2's headers, SWIG and doxygen, plus a
# `wxruby setup` step that compiles for several minutes:
#
#   bundle config set --local with wx && bundle install && wxruby setup
#
group :wx, optional: true do
  gem "wxruby3", "~> 1.8"
end
